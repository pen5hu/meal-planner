{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Meal Schema",
  "type": "object",
  "required": ["meals"],
  "additionalProperties": false,
  "properties": {
    "meals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "category",
          "ingredients"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "ingredients": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
